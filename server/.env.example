# Puerto de la API
PORT=3000
# Origen permitido por CORS (URL del client)
CLIENT_ORIGIN=http://localhost:5173
# URL del proyecto de Supabase
SUPABASE_URL=
# Llave anon: el backend consulta con el JWT del usuario para que RLS aplique
SUPABASE_ANON_KEY=
# Llave service_role: SOLO servidor (alta de usuarios y endpoints internos). Nunca en el client.
SUPABASE_SERVICE_ROLE_KEY=
# Llave compartida con n8n para /api/internal/*
N8N_API_KEY=
