# Puerto de la API
PORT=3000
# Origen permitido por CORS (URL del client)
CLIENT_ORIGIN=http://localhost:5173
# URL del proyecto de Supabase
SUPABASE_URL=
# Llave anon: el backend consulta con el JWT del usuario para que RLS aplique
SUPABASE_ANON_KEY=
# Llave service_role: SOLO servidor (alta de usuarios y endpoints internos). Nunca en el client.
SUPABASE_SERVICE_ROLE_KEY=
# Llave compartida con n8n para /api/internal/*
N8N_API_KEY=

# --- Solo para `npm run db:seed-users` (usuarios de prueba; usa contraseñas propias y distintas) ---
# El administrador es obligatorio; los demás roles se omiten si no defines su contraseña.
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_PASTOR=
SEED_PASSWORD_SECRETARY=
SEED_PASSWORD_TREASURER=
SEED_PASSWORD_COORDINATOR=
# Dominio de los correos de prueba (admin@iglesia.test, pastor@iglesia.test, ...)
SEED_EMAIL_DOMAIN=iglesia.test
